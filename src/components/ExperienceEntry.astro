---
import type { CV } from '../types';
const { employer } = Astro.props as { employer: CV['experience'][number] };
---
<article class="employer">
  <div class="entry-heading">
    <h3>{employer.company}</h3>
    <span class="location">{employer.location}</span>
  </div>
  {employer.roles.map((role) => (
    <div class="role">
      <div class="entry-heading">
        <h4>{role.title}</h4>
        <span class="date">{role.dates}</span>
      </div>
      <ul>{role.points.map((point) => <li>{point}</li>)}</ul>
    </div>
  ))}
</article>
